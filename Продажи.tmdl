table Продажи
	lineageTag: 2cd4795a-34dc-4d9d-90c0-59aae9f8ed01

	measure Количество продано = SUM(Продажи[Количество])
		formatString: #,0

	measure Выручка = SUMX(Продажи, Продажи[Количество] * Продажи[Цена])
		formatString: #,0

	measure Средняя цена = DIVIDE([Выручка], SUM(Продажи[Количество]))
		formatString: #,0.0

	measure Выручка за прошлый месяц = CALCULATE([Выручка], DATEADD('Календарь'[Дата], -1, MONTH))
		formatString: #,0

	measure Рост к прошлому месяцу % = DIVIDE([Выручка] - [Выручка за прошлый месяц], [Выручка за прошлый месяц])
		formatString: +0.0%;-0.0%;0.0%

	measure Кумулятивная выручка = CALCULATE([Выручка], DATESYTD('Календарь'[Дата]))
		formatString: #,0

	column Дата
		dataType: dateTime
		formatString: Short Date
		lineageTag: a293c0ff-542f-4655-9833-03229096a344
		summarizeBy: none
	column ID_магазина
		dataType: int64
		lineageTag: 07289223-a21a-4309-9a06-cdcedfc73e77
		summarizeBy: none
	column ID_товара
		dataType: int64
		lineageTag: 360862fe-fc64-4697-9b76-fcac7abc97a0
		summarizeBy: none
	column Количество
		dataType: int64
		lineageTag: 3ab92888-57d6-437c-8565-b996423991c0
		summarizeBy: sum
	column Цена
		dataType: double
		formatString: #,0.00
		lineageTag: 44b49978-ece9-497f-9bc1-cd43c7a10be8
		summarizeBy: none

